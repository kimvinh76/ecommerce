# ===== Server Configuration =====
PORTBE=8081
API_TAG=/api/v1
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ===== Database Configuration =====
MONGODB_URL=mongodb+srv://YOUR_MONGODB_USER:YOUR_MONGODB_PASSWORD@cluster0.xxxxx.mongodb.net/superbook?retryWrites=true&w=majority&appName=Cluster0

# ===== JWT Configuration =====
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRES_IN=1d

# ===== Email Configuration =====
MAIL_ADMIN=admin@bookstore.com
MAIL_USER=your_gmail@gmail.com
MAIL_PASS=your_gmail_app_password

# ===== Cloudinary Configuration =====
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ===== Google OAuth Configuration =====
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CLIENT_CALLBACKURL=/api/v1/auth/callback/google



# ===== Bank Configuration (VietQR) =====
BANK_BIN=970422
BANK_ACCOUNT_NUMBER=your_bank_account_number
BANK_ACCOUNT_NAME=SUPER BOOKSTORE

# ===== MoMo Payment Configuration =====
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_REQUEST_TYPE=payWithMethod
MOMO_RETURN_URL=http://localhost:8081/api/v1/payment/momo-return
MOMO_IPN_URL=http://localhost:8081/api/v1/payment/momo-ipn
